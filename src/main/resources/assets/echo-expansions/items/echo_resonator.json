          },
          "on_false": {
            "type": "minecraft:model",
            "model": "echo-expansions:item/echo_resonator_shard_unlinked"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "property": "echo-expansions:resonator_glow",
        "on_true": {
          "type": "minecraft:model",
          "model": "echo-expansions:item/echo_resonator_remote_powered"
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "echo-expansions:item/echo_resonator_remote_unpowered"
        }
      },
      {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "echo-expansions:ribbon",
